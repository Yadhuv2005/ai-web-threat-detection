# ================================================================
# Web Threat Detection & Real-Time Alerting System Configuration
# ================================================================

# System Environment
ENVIRONMENT=development
DEBUG=True

# Test Website Settings
TARGET_HOST=127.0.0.1
TARGET_PORT=8001
LOG_FILE_PATH=test_website/logs/access.log

# Monitoring Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./threat_detection.db

# Machine Learning Classification Settings
CONFIDENCE_THRESHOLD=0.75
MODEL_PATH=ml/saved_models/threat_classifier.pkl
VECTORIZER_PATH=ml/saved_models/tfidf_vectorizer.pkl

# Behavioral Detection Thresholds
FAILED_LOGIN_THRESHOLD=5       # Max failed logins from a single IP before alert
FAILED_LOGIN_WINDOW_SEC=60     # Time window in seconds for failed logins
REQUEST_RATE_THRESHOLD=25      # Max requests from single IP before rate alert
REQUEST_RATE_WINDOW_SEC=10     # Time window in seconds for request rate

# Real-Time Alert Notification Settings
ALERT_COOLDOWN_SECONDS=60      # Suppress duplicate alerts for same IP + Threat type

# Email Alerts (Optional SMTP)
ENABLE_EMAIL_ALERTS=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAIL=admin@example.com

# SMS Alerts (Optional Twilio)
ENABLE_SMS_ALERTS=False
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_PHONE=+1234567890
ALERT_RECIPIENT_PHONE=+1987654321
